    "global_rules": [
      "HOLD, ABORT, and STOP override every planned duration, trigger, profile, transition, finale action, and release target.",
      "Only an authorized person may release a hold and select a rehearsed restart point.",
      "Audience release and teardown require their independent positive safety gates; COMPLETE is not sufficient."
    ],
    "unresolved_questions": [
