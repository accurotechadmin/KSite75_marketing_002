  "data": {
    "authority_boundary": "Review-ready vocabulary only; it does not approve calls, equipment procedures, people, or a performance. Venue emergency authority and approved equipment procedures govern in operation.",
    "namespace_boundary": "These are operational show-control states, not Timeline Moment record lifecycle states.",
    "precedence": [
      "ABORT",
      "STOP",
      "HOLD",
      "approved safety restriction",
      "planned timing and schedule"
    ],
    "unknown_transition_rule": "A transition not explicitly allowed is prohibited. Missing evidence is negative; silence is not confirmation; null is not GO.",
    "states": [
      {
        "state_id": "SHOW-PRESET",
        "state": "PRESET",
        "class": "planned",
        "meaning": "Conditions are being established; no execution authority.",
        "requires_authorized_transition": false
      },
      {
        "state_id": "SHOW-WARNING",
        "state": "WARNING",
        "class": "planned",
        "meaning": "Advance notice that an identified action may approach; not authority to execute.",
        "requires_authorized_transition": false
      },
      {
        "state_id": "SHOW-STANDBY",
        "state": "STANDBY",
        "class": "planned",
        "meaning": "Named recipients acknowledge readiness for an identified prospective cue; not authority to execute.",
        "requires_authorized_transition": false
      },
      {
        "state_id": "SHOW-GO",
        "state": "GO",
        "class": "planned",
        "meaning": "Authorized release of one identified, approved cue after prerequisites are positively confirmed.",
        "requires_authorized_transition": true
      },
      {
        "state_id": "SHOW-CONFIRM",
        "state": "CONFIRM",
        "class": "planned",
        "meaning": "Named recipient reports objective completion or state evidence; does not release a new cue.",
        "requires_authorized_transition": false
      },
      {
        "state_id": "SHOW-HOLD",
        "state": "HOLD",
        "class": "protective",
        "meaning": "Pause progression and prevent new GO calls while the condition is evaluated.",
        "requires_authorized_transition": true
      },
      {
        "state_id": "SHOW-ABORT",
        "state": "ABORT",
        "class": "emergency",
        "meaning": "Prevent or terminate the identified unsafe action using its approved equipment-specific procedure.",
        "requires_authorized_transition": true
      },
      {
        "state_id": "SHOW-STOP",
        "state": "STOP",
        "class": "emergency",
        "meaning": "Immediately stop show progression or affected operation under applicable safety authority.",
        "requires_authorized_transition": true
      },
      {
        "state_id": "SHOW-RESET",
        "state": "RESET",
        "class": "recovery",
        "meaning": "Controlled restoration after stop/abort; it is not permission to resume show progression.",
        "requires_authorized_transition": true
      },
      {
        "state_id": "SHOW-RESTART_READY",
        "state": "RESTART_READY",
        "class": "recovery",
        "meaning": "Evidence package and rehearsed restart point are positively accepted by authorized roles; a separate GO remains required.",
        "requires_authorized_transition": true
      },
      {
        "state_id": "SHOW-COMPLETE",
        "state": "COMPLETE",
        "class": "terminal",
        "meaning": "The identified sequence is objectively complete; teardown still requires safe-stage release.",
        "requires_authorized_transition": false
      }
    ],
    "allowed_transitions": [
      {
        "from": "PRESET",
        "to": "WARNING",
        "authority_roles": [
          "role:stage_manager"
        ],
        "required_evidence": [
          "identified approved cue or event",
          "current approved calling material"
        ]
      },
