  "data": {
    "extraction_state": "complete",
    "approval_state": "pending controlled approval",
    "schema_target": "conflict.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "conflict.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Conflict record",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "claim_scope",
        "status",
        "materiality",
        "candidates",
        "affected_document_ids",
        "decision_owner_role",
        "created_at"
      ],
      "properties": {
        "conflict_id": {
          "type": "string",
          "pattern": "^CONFLICT-[0-9]{3,}$"
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "under_review",
            "resolved",
            "accepted_variance",
            "superseded"
          ]
        },
        "materiality": {
          "type": "string",
          "enum": [
            "informational",
            "minor",
            "material",
            "safety_critical"
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "value",
              "source_refs",
              "authority_assessment"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]*$"
              },
              "value": {},
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "source_reference.schema.json#/data/schema"
                }
              },
              "authority_assessment": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "affected_document_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          },
          "uniqueItems": true
        },
        "decision_owner_role": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": [
            "object",
            "null"
          ]
        },
        "approval_evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "source_mapping": [
      "The Supporting Production Documentation Standard supplies controlled identity, revision, approval, distribution, and supersession rules.",
      "Repository settings and owner-center contracts are reconciled as implementation evidence, not promoted over formal authority.",
      "Approval is represented as evidence-bearing state; review completion alone cannot satisfy approved conditions."
    ],
    "validation_notes": [
      "Formats require a JSON Schema validator with format assertion enabled.",
      "Domain vocabularies remain external authorities and are intentionally not duplicated as exhaustive enums."
    ]
  }
}
