      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "record_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
