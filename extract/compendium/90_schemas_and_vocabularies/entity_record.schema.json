        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted",
            "safety_sensitive"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
