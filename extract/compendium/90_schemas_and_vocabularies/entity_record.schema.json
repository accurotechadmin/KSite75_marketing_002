                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]*$"
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]*$"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
