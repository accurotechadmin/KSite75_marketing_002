    "schema": {
      "$id": "entity_record.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Entity record",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_type",
        "title",
        "status",
        "timeline_scope",
        "visibility",
        "confidence",
        "source_refs",
        "relationships",
