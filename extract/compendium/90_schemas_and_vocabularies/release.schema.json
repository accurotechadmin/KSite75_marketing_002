  "data": {
    "extraction_state": "complete",
    "approval_state": "pending controlled approval",
    "schema_target": "release.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "release.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Controlled release",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "release_type",
        "scope",
        "status",
        "included_documents",
        "gates",
        "approval",
        "created_at"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^REL-[A-Z0-9-]+$"
        },
        "release_type": {
          "type": "string",
          "enum": [
            "program",
            "technical",
            "website",
            "campaign",
            "compendium",
            "export"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "blocked",
            "approved",
            "published",
            "superseded",
            "withdrawn"
          ]
        },
        "included_documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "document_id",
              "revision",
              "sha256"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]*$"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gate_id",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "gate_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]*$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "failed",
                  "blocked",
                  "passed",
                  "not_applicable"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._:-]*$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "owner_role",
            "approver_role",
            "approved_at",
            "evidence_ref"
          ],
          "properties": {
            "owner_role": {
              "type": "string",
              "minLength": 1
            },
            "approver_role": {
              "type": "string",
              "minLength": 1
            },
            "approved_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "evidence_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "effective_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "supersedes_release_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "approved",
                  "published"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "approval": {
                "properties": {
                  "approved_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source_mapping": [
      "The Supporting Production Documentation Standard supplies controlled identity, revision, approval, distribution, and supersession rules.",
      "Repository settings and owner-center contracts are reconciled as implementation evidence, not promoted over formal authority.",
      "Approval is represented as evidence-bearing state; review completion alone cannot satisfy approved conditions."
    ],
    "validation_notes": [
      "Formats require a JSON Schema validator with format assertion enabled.",
      "Domain vocabularies remain external authorities and are intentionally not duplicated as exhaustive enums."
    ]
  }
}
