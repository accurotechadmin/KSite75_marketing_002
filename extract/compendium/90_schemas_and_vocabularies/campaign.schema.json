    "schema_target": "campaign.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "campaign.schema.json",
      "title": "Campaign",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "campaign_id",
        "funnel_stage",
        "channels",
        "release_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^CAM-[A-Z0-9][A-Z0-9._-]*$"
        },
        "funnel_stage": {
          "enum": [
            "awareness",
            "interest",
            "consideration",
            "conversion",
            "retention_nurture"
          ]
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurement_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_state": {
          "enum": [
            "planning",
            "creative_review",
            "rights_review",
            "approval_pending",
            "approved_with_evidence",
            "released",
            "paused",
            "retired"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "release_state": {
                "enum": [
                  "approved_with_evidence",
                  "released"
                ]
              }
            },
            "required": [
              "release_state"
            ]
          },
          "then": {
            "properties": {
              "approval_evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "approval_evidence_refs"
            ]
          }
        }
      ]
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
