  "data": {
    "extraction_state": "complete",
    "approval_state": "pending controlled approval",
    "schema_target": "content_token.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "content_token.schema.json",
      "title": "Content Token",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "token_id",
        "value",
        "content_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "token_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "placement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibility_purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_state": {
          "enum": [
            "draft",
            "fact_check",
            "rights_review",
            "approval_pending",
            "approved_with_evidence",
            "published",
            "withdrawn"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "content_state": {
                "enum": [
                  "approved_with_evidence",
                  "published"
                ]
              }
            },
            "required": [
              "content_state"
            ]
          },
          "then": {
            "properties": {
              "approval_evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "approval_evidence_refs"
            ]
          }
        }
      ]
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
}
