  "data": {
    "extraction_state": "complete",
    "approval_state": "pending controlled approval",
    "schema_target": "equipment_instance.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "equipment_instance.schema.json",
      "title": "Equipment Instance",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "instance_id",
        "equipment_type_ref",
        "maintenance_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
        },
        "equipment_type_ref": {
          "type": "string",
          "minLength": 1
        },
        "dmx_patch": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "universe",
            "start_address",
            "footprint"
          ],
          "properties": {
            "universe": {
              "type": "integer",
              "minimum": 1
            },
            "start_address": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "footprint": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            }
          },
          "allOf": [
            {
              "properties": {
                "start_address": {},
                "footprint": {}
              }
            }
          ]
        },
        "geometry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "required": [
            "verification_state"
          ],
          "properties": {
            "verification_state": {
              "enum": [
                "surveyed",
                "measured",
                "estimated",
                "unverified"
              ]
            }
          }
        },
        "power_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "maintenance_state": {
          "enum": [
            "serviceable",
            "inspection_due",
            "restricted",
            "tagged_out",
            "repair_pending",
            "unknown"
          ]
        },
        "last_inspected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dmx_patch": {
                "type": "object"
              }
            },
            "required": [
              "dmx_patch"
            ]
          },
          "then": {
            "properties": {
              "dmx_patch": {
                "properties": {
                  "start_address": {
                    "maximum": 512
                  },
                  "footprint": {
                    "maximum": 512
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Address and footprint bounds are checked individually; start_address + footprint - 1 and cross-record universe overlap are enforced by the companion validation suite."
    ]
  }
}
