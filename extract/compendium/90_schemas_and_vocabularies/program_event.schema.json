    "schema_target": "program_event.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "program_event.schema.json",
      "title": "Program Event",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "event_id",
        "event_family",
        "order",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_id": {
          "type": "string",
          "pattern": "^(PGM|TECH|FIN)-[0-9]{3}$"
        },
        "event_family": {
          "enum": [
            "PGM",
            "TECH",
            "FIN"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "value",
            "basis",
            "verification_state"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9]$"
            },
            "basis": {
              "enum": [
                "supplied",
                "calculated",
                "estimated",
                "unknown"
              ]
            },
            "verification_state": {
              "enum": [
                "verified",
                "provisional",
                "estimated",
                "unverified"
              ]
            }
          }
        },
        "predecessor_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(PGM|TECH|FIN)-[0-9]{3}$"
          }
        }
      },
      "allOf": [
        {
          "properties": {
            "event_id": {
              "pattern": "^(PGM|TECH|FIN)-[0-9]{3}$"
            }
          }
        }
      ]
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
}
