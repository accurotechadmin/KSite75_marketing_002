  "data": {
    "extraction_state": "complete",
    "approval_state": "pending controlled approval",
    "governance": {
      "authority_scope": "Stable namespaces for controlled documents, program and technical events, Timeline moments, entities, sources, decisions, conflicts, and releases.",
      "change_rule": "Add, deprecate, or change meanings only through controlled review; preserve stable IDs and map legacy values.",
      "approval_required_for_effective_use": true
    },
    "source_mapping": [
      "Formal DOCX controls take precedence within their domains.",
      "Settings and center contracts were normalized without treating prototype labels as approved canon.",
      "Records remain REVIEW until a named authorized approver supplies controlled evidence."
    ],
    "records": [
      {
        "record_id": "namespace:document",
        "label": "Compendium document",
        "definition": "Lowercase stable document identifier matching the manifest and filename stem.",
        "status": "review",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "example": "document.schema"
      },
      {
        "record_id": "namespace:pgm",
        "label": "Program event",
        "definition": "Immutable Cue Book program-event identity.",
        "status": "review",
        "pattern": "^PGM-[0-9]{3}$",
        "example": "PGM-001"
      },
      {
        "record_id": "namespace:tech",
        "label": "Special technical event",
        "definition": "Immutable Cue Book technical-event identity.",
        "status": "review",
        "pattern": "^TECH-[0-9]{3}$",
        "example": "TECH-001"
      },
      {
        "record_id": "namespace:fin",
        "label": "Finale event",
        "definition": "Immutable Cue Book finale identity.",
        "status": "review",
        "pattern": "^FIN-[0-9]{3}$",
        "example": "FIN-001"
      },
      {
        "record_id": "namespace:timeline",
        "label": "Timeline moment",
        "definition": "Governed moment family or GEN for non-timeline-specific records.",
        "status": "review",
        "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$",
        "example": "SONG-001"
      },
      {
        "record_id": "namespace:cue",
        "label": "Department cue",
        "definition": "Department code plus stable sequence; each cue references PGM, TECH, or FIN authority.",
        "status": "review",
        "pattern": "^(SM|AUD|LX|VID|SCN|AUTO|DECK|WARD|PERF|PROP|FX|FOH|COMMS|PWR|SAFE)-[0-9]{3}$",
        "example": "LX-001"
      },
      {
        "record_id": "namespace:fixture",
        "label": "Equipment instance",
        "definition": "Stable physical or logical equipment-instance identity.",
        "status": "review",
        "pattern": "^FIX-[A-Z0-9-]+$",
        "example": "FIX-PAR-001"
      },
      {
        "record_id": "namespace:asset",
        "label": "Asset",
        "definition": "Stable physical or digital asset identity.",
        "status": "review",
        "pattern": "^AST-[A-Z0-9-]+$",
        "example": "AST-PHOTO-001"
      },
      {
        "record_id": "namespace:event",
        "label": "Event",
        "definition": "Stable production event identity.",
        "status": "review",
        "pattern": "^EVT-[A-Z0-9-]+$",
        "example": "EVT-2026-001"
      },
      {
        "record_id": "namespace:person",
        "label": "Person",
        "definition": "Restricted-safe pseudonymous person identifier; never embeds contact data.",
        "status": "review",
        "pattern": "^PER-[0-9]{3,}$",
        "example": "PER-001"
      },
      {
        "record_id": "namespace:source",
        "label": "Source",
        "definition": "Stable evidence-source identity.",
        "status": "review",
        "pattern": "^SRC-[A-Z0-9-]+$",
        "example": "SRC-GEN-001"
      },
      {
        "record_id": "namespace:decision",
        "label": "Decision",
        "definition": "Controlled decision-log identity.",
        "status": "review",
        "pattern": "^DEC-[A-Z0-9-]+$",
        "example": "DEC-GEN-001"
      },
      {
        "record_id": "namespace:conflict",
        "label": "Conflict",
        "definition": "Material conflict-register identity.",
        "status": "review",
        "pattern": "^CONFLICT-[0-9]{3,}$",
        "example": "CONFLICT-001"
      },
      {
        "record_id": "namespace:release",
        "label": "Release",
        "definition": "Immutable controlled release identity.",
        "status": "review",
        "pattern": "^REL-[A-Z0-9-]+$",
        "example": "REL-COMPENDIUM-001"
      }
    ],
    "record_count": 14
  }
}
