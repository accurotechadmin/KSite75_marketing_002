  "data": {
    "extraction_state": "complete",
    "approval_state": "pending controlled approval",
    "schema_target": "scene_profile.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "scene_profile.schema.json",
      "title": "Scene Profile",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "profile_id",
        "layers",
        "verification_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer_ref",
              "values"
            ],
            "properties": {
              "layer_ref": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": [
                    "number",
                    "integer",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "view_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "patch_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "compatibility": {
          "enum": [
            "verified",
            "requires_validation",
            "incompatible",
            "unknown"
          ]
        },
        "verification_state": {
          "enum": [
            "tested",
            "reviewed",
            "draft",
            "unverified"
          ]
        }
      }
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
}
