    "schema_target": "asset.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "asset.schema.json",
      "title": "Asset",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "asset_id",
        "asset_kind",
        "rights_state",
        "publication_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asset_id": {
          "type": "string",
          "pattern": "^AST-[A-Z0-9][A-Z0-9._-]*$"
        },
        "asset_kind": {
          "enum": [
            "physical",
            "digital",
            "hybrid"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "storage_reference": {
          "type": [
            "string",
            "null"
          ],
          "description": "Controlled indirection; never embed credentials or restricted payloads."
        },
        "intended_uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edit_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rights_state": {
          "enum": [
            "owned",
            "licensed",
            "cleared",
            "review_required",
            "restricted",
            "expired",
            "unknown"
          ]
        },
        "rights_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publication_state": {
          "enum": [
            "not_public",
            "candidate",
            "approval_pending",
            "approved_with_evidence",
            "published",
            "withdrawn"
          ]
        },
        "accessibility_metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alt_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "caption": {
              "type": [
                "string",
                "null"
              ]
            },
            "transcript_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publication_state": {
                "enum": [
                  "approved_with_evidence",
                  "published"
                ]
              }
            },
            "required": [
              "publication_state"
            ]
          },
          "then": {
            "properties": {
              "rights_state": {
                "enum": [
                  "owned",
                  "licensed",
                  "cleared"
                ]
              },
              "rights_evidence_refs": {
                "minItems": 1
              },
              "approval_evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "rights_evidence_refs",
              "approval_evidence_refs"
            ]
          }
        }
      ]
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
}
