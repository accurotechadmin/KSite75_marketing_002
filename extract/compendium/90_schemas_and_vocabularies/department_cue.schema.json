    "schema_target": "department_cue.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "department_cue.schema.json",
      "title": "Department Cue",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "cue_id",
        "department",
        "event_ref",
        "trigger",
        "action",
        "safety_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cue_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[0-9]{3,}$"
        },
        "department": {
          "type": "string",
          "minLength": 2
        },
        "event_ref": {
          "type": "string",
          "pattern": "^(PGM|TECH|FIN)-[0-9]{3}$"
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "verification_state"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "verification_state": {
              "enum": [
                "verified",
                "provisional",
                "unverified"
              ]
            }
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "timing_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "confirmation": {
          "type": [
            "string",
            "null"
          ]
        },
        "abort_or_hold_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "safety_state": {
          "enum": [
            "not_applicable",
            "pending_review",
            "restricted",
            "approved_with_evidence",
            "hold",
            "prohibited"
          ]
        }
      }
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
}
