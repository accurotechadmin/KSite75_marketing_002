    "schema_target": "form_submission.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "form_submission.schema.json",
      "title": "Form Submission",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "submission_id",
        "form_id",
        "received_at",
        "privacy_classification",
        "secure_storage_ref",
        "consent",
        "processing_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "submission_id": {
          "type": "string",
          "pattern": "^SUB-[A-Z0-9][A-Z0-9._-]*$"
        },
        "form_id": {
          "type": "string",
          "minLength": 1
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "privacy_classification": {
          "enum": [
            "restricted_personal_data",
            "restricted_sensitive_data"
          ]
        },
        "secure_storage_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque reference to access-controlled storage; not a payload, email body, credential, or secret."
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "captured_at",
            "evidence_ref"
          ],
          "properties": {
            "basis": {
              "enum": [
                "explicit",
                "contractual",
                "legitimate_interest",
                "not_applicable"
              ]
            },
            "captured_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "processing_state": {
          "enum": [
            "received",
            "triaged",
            "in_progress",
            "completed",
            "rejected",
            "retention_hold",
            "deleted"
          ]
        },
        "retention_due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "data_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Category labels only; never raw values."
        },
        "raw_payload": false,
        "mail_body": false,
        "secret": false
      }
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "The schema intentionally forbids raw_payload, mail_body, and secret properties and requires secure indirection.",
      "Authorization, encryption, retention execution, and consent validity require application and human controls beyond JSON Schema."
    ]
  }
}
