  "data": {
    "extraction_state": "complete",
    "approval_state": "pending controlled approval",
    "schema_target": "inspection_report.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "inspection_report.schema.json",
      "title": "Inspection Report",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "inspection_id",
        "scope_ref",
        "performed_at",
        "inspector_role",
        "checklist_results",
        "findings",
        "safety_disposition",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inspection_id": {
          "type": "string",
          "pattern": "^INSP-[A-Z0-9][A-Z0-9._-]*$"
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "performed_at": {
          "type": "string",
          "format": "date-time"
        },
        "inspector_role": {
          "type": "string",
          "minLength": 1
        },
        "checklist_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "result"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "not_applicable",
                  "not_inspected"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "severity",
              "state"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "observation",
                  "minor",
                  "major",
                  "critical"
                ]
              },
              "state": {
                "enum": [
                  "open",
                  "mitigated",
                  "verified_closed",
                  "accepted_by_authority"
                ]
              },
              "corrective_action_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "safety_disposition": {
          "enum": [
            "serviceable",
            "restricted",
            "tagged_out",
            "requires_authority_review"
          ]
        },
        "sign_off": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "role",
            "evidence_ref",
            "signed_at"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1
            },
            "signed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "next_due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "safety_disposition": {
                "const": "serviceable"
              }
            },
            "required": [
              "safety_disposition"
            ]
          },
          "then": {
            "required": [
              "sign_off"
            ]
          }
        }
      ]
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
}
