    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "public_route_section.schema.json",
      "title": "Public Route Section",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "title",
        "status",
        "timeline_scope",
        "route",
        "section_id",
        "order",
        "visibility_state",
        "publication_state",
        "confidence",
        "source_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "timeline_scope": {
          "type": "string",
          "pattern": "^(GEN|(PRE|OPEN|SET|SONG|TRN|CST|VID|LGT|FOG|STR|SPK|FIN|ENC|POST)-[0-9]{3})$"
        },
        "confidence": {
          "enum": [
            "verified",
            "provisional",
            "estimated",
            "unverified",
            "not_applicable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "source_reference.schema.json#/data/schema"
          }
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route": {
          "type": "string",
          "pattern": "^/[a-z0-9/_-]*$"
        },
        "section_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "binding_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visibility_state": {
          "enum": [
            "public",
            "internal_preview",
            "hidden",
            "restricted"
          ]
        },
        "accessibility_review_state": {
          "enum": [
            "not_started",
            "in_review",
            "changes_required",
            "verified"
          ]
        },
        "publication_state": {
          "enum": [
            "draft",
            "review",
            "approval_pending",
            "approved_with_evidence",
            "published",
            "withdrawn"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publication_state": {
                "const": "published"
              }
            },
            "required": [
              "publication_state"
            ]
          },
          "then": {
            "properties": {
              "visibility_state": {
                "const": "public"
              },
              "accessibility_review_state": {
                "const": "verified"
              },
              "approval_evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "approval_evidence_refs"
            ]
          }
        }
      ]
    },
    "source_mapping": [
      "Authoritative controls are modeled as shape and evidence requirements without promoting draft business facts to constants.",
      "Repository records were sampled across the documented source family; uncertain values retain confidence or verification state."
    ],
    "validation_notes": [
      "Draft 2020-12 schema checking and representative positive/negative instance tests are required.",
      "Cross-record uniqueness, overlap, authority, and approval require registry or workflow validation beyond JSON Schema."
    ]
  }
