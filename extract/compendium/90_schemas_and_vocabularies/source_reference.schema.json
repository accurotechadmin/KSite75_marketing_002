    "schema_target": "source_reference.schema",
    "json_schema_draft": "2020-12",
    "schema": {
      "$id": "source_reference.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Source reference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "path",
        "sha256",
        "locator",
        "extraction_method",
        "use"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision_or_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "extraction_method": {
          "type": "string",
          "enum": [
            "structural review and reconciliation",
            "manual transcription",
            "machine parse",
            "hash comparison",
            "generated derivation"
          ]
        },
        "use": {
          "type": "string",
          "enum": [
            "normative input",
            "reconciled implementation input",
            "supporting evidence",
            "conflicting candidate",
            "generated input"
          ]
        },
        "quoted_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "redaction_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_mapping": [
      "The Supporting Production Documentation Standard supplies controlled identity, revision, approval, distribution, and supersession rules.",
      "Repository settings and owner-center contracts are reconciled as implementation evidence, not promoted over formal authority.",
      "Approval is represented as evidence-bearing state; review completion alone cannot satisfy approved conditions."
    ],
    "validation_notes": [
      "Formats require a JSON Schema validator with format assertion enabled.",
      "Domain vocabularies remain external authorities and are intentionally not duplicated as exhaustive enums."
    ]
  }
